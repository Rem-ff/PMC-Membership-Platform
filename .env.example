# ---------------------------------------------------------------------------
# PMC Membership Platform -- environment variables
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (any hosted Postgres: Neon, Supabase, RDS, etc.)
DATABASE_URL=postgres://user:password@host:5432/pmc

# Used only by `pnpm --filter @workspace/api-server run test` against a
# throwaway database. Leave unset to make tests fall back to DATABASE_URL
# (NOT recommended against a real/production database).
TEST_DATABASE_URL=postgres://user:password@host:5432/pmc_test

# Clerk (https://dashboard.clerk.com) -- Email + Google sign-in
CLERK_SECRET_KEY=sk_live_xxx
CLERK_PUBLISHABLE_KEY=pk_live_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx

# The email address of the club President's Clerk account. The seed script
# creates/links the PRESIDENT member record for this email -- do not put the
# real password anywhere in source control, only this address.
PMC_PRESIDENT_EMAIL=president@example.com

# Public base URL of the deployed frontend, used to build membership-card
# QR codes and verification links (e.g. https://pmc.example.com).
APP_BASE_URL=http://localhost:5173

# Port the Express API listens on.
PORT=5000

# Base URL the frontend uses to reach the API (set this when frontend and
# API are deployed to different hosts/domains).
VITE_API_BASE_URL=http://localhost:5000
